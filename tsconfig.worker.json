{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "outDir": "node_modules/.tmp/worker",
    "tsBuildInfoFile": "node_modules/.tmp/worker.tsbuildinfo",
    "lib": ["ES2023"],
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["worker", "shared", "shared/*.json"]
}
